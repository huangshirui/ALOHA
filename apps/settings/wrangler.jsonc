{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aloha-app-settings",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "keep_vars": true,
  "main": "./src/entrypoint.ts",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/settings*"
    ]
  },
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_STATE",
        "class_name": "WorkspaceState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "workspace-v1",
      "new_sqlite_classes": [
        "WorkspaceState"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "aloha-app-settings-staging",
      "workers_dev": false,
      "preview_urls": false,
      "keep_vars": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/settings*"
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "WORKSPACE_STATE",
            "class_name": "WorkspaceState"
          }
        ]
      },
      "migrations": [
        {
          "tag": "workspace-v1",
          "new_sqlite_classes": [
            "WorkspaceState"
          ]
        }
      ]
    }
  }
}
