{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aloha-app-settings",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "keep_vars": true,
  "keep_vars": true,
  "main": "./src/worker.ts",
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/settings*"]
  }
}
