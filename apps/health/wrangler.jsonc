{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aloha-app-health",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health/api/*"
    ]
  },
  "main": "./src/worker.ts"
}
